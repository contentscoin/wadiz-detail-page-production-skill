{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://github.com/contentscoin/wadiz-detail-page-production-skill/contracts/v1",
  "title":"Wadiz production contracts v1",
  "$defs":{
    "source":{"type":"object","required":["quote","reviewed"],"properties":{"file":{"type":"string"},"url":{"type":"string","format":"uri"},"quote":{"type":"string","minLength":1},"reviewed":{"type":"boolean"}},"anyOf":[{"required":["file"]},{"required":["url"]}]},
    "fact":{"type":"object","required":["id","text","status"],"properties":{"id":{"type":"string","minLength":1},"text":{"type":"string","minLength":1},"status":{"enum":["confirmed","assumption","confirmation_needed","blocked"]},"attribute":{"type":"string"},"role":{"type":"string"},"tags":{"type":"array","items":{"type":"string"}},"source":{"$ref":"#/$defs/source"}},"if":{"properties":{"status":{"const":"confirmed"}}},"then":{"required":["source"],"properties":{"source":{"properties":{"reviewed":{"const":true}}}}}},
    "reference":{"type":"object","required":["file","role"],"properties":{"file":{"type":"string","minLength":1},"role":{"type":"string"},"truth_level":{"enum":["actual_asset","reference_only","generated_concept"]}}},
    "ProductBrief":{"type":"object","required":["schema_version","product","facts","assets"],"properties":{"schema_version":{"const":1},"product":{"type":"object","required":["name","category","topic"],"properties":{"name":{"type":"string","minLength":1},"category":{"type":"string"},"topic":{"enum":["gift","problem_solution","new_product","premium","comparison","relaunch"]},"sku":{"type":"string"},"options":{"type":"array"},"target_customer":{"type":"string"}}},"facts":{"type":"array","items":{"$ref":"#/$defs/fact"}},"assets":{"type":"array","items":{"type":"object","required":["id","file","truth_level"],"properties":{"id":{"type":"string"},"file":{"type":"string"},"truth_level":{"enum":["actual_asset","reference_only","generated_concept"]}}}},"unknowns":{"type":"array","items":{"type":"string"}}}},
    "PagePlan":{"type":"object","required":["schema_version","sections"],"properties":{"schema_version":{"const":1},"product_name":{"type":"string"},"category":{"type":"string"},"topic":{"type":"string"},"style":{"type":"string"},"sections":{"type":"array","minItems":1,"items":{"type":"object","required":["id","role","questions","copy","fact_ids","evidence_ids","media_job_id"],"properties":{"id":{"type":"string","minLength":1},"role":{"type":"string"},"questions":{"type":"array","items":{"enum":["Q1","Q2","Q3","Q4","Q5","Q6","Q7","Q8"]}},"copy":{"type":"object","required":["headline"],"properties":{"headline":{"type":"string"},"subcopy":{"type":"string"},"body":{"type":"string"},"footnote":{"type":"string"},"cta":{"type":"string"}}},"fact_ids":{"type":"array","items":{"type":"string"}},"evidence_ids":{"type":"array","items":{"type":"string"}},"media_job_id":{"type":"string","minLength":1},"visual_direction":{"type":"string"},"placement_reason":{"type":"string"}}}}}},
    "MediaJob":{"type":"object","required":["id","section_id","kind","purpose","backend","model_requested","input_refs","status"],"properties":{"id":{"type":"string","minLength":1},"section_id":{"type":"string"},"kind":{"enum":["image","gif"]},"purpose":{"type":"string"},"backend":{"enum":["codex_native","ima2"]},"model_requested":{"enum":["gpt-image-2.5-sunburst","gpt-image-2.5-flare","gpt-image-2.5-sunburst-2026-09-08","gpt-image-2.5-flare-2026-09-08"]},"requires_product_reference":{"type":"boolean","default":true},"input_refs":{"type":"array","items":{"$ref":"#/$defs/reference"}},"prompt":{"type":"string"},"prompt_file":{"type":"string"},"truth_level":{"enum":["actual_asset","reference_only","generated_concept"]},"status":{"enum":["pending","blocked","planned","complete","failed"]}}},
    "DeliveryManifest":{"type":"object","required":["schema_version","sections","publication_status"],"properties":{"schema_version":{"const":1},"publication_status":{"enum":["blocked","review_required","ready"]},"sections":{"type":"array","items":{"type":"object","required":["id","job_id","kind","file"],"properties":{"id":{"type":"string"},"job_id":{"type":"string"},"kind":{"enum":["image","gif"]},"file":{"type":"string"},"poster":{"type":"string"},"truth_level":{"type":"string"},"sha256":{"type":"string"}}}}}}
  }
}
